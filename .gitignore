# Local Claude Code settings and preview config — machine-specific, not site content.
# Until now these were excluded by hand on every commit, which only had to be
# forgotten once.
.claude/

# Node, if dependencies ever get installed locally
node_modules/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Screen recordings and raw promo footage. These land in this folder because it
# is where the site lives, but they are hundreds of megabytes and would be
# published to the live site as well as bloating the repo permanently.
*.mp4
*.mov
*.webm
